# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Local development server ---
# HOST=0.0.0.0
# PORT=4000
# DB_PATH=./data/mermelada.db
# NG_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Authentication (opt-in; see README) ---
# AUTH_ENABLED=false
# AUTH_SECRET=dev-only-secret
# AUTH_SEED_PASSWORD=mermelada123
# AUTH_TOKEN_TTL_SECONDS=28800

# --- UI protection (opt-in; HTTP Basic Auth for the Angular shell) ---
# UI_AUTH_ENABLED=false
# UI_AUTH_USER=erp-ui
# UI_AUTH_PASSWORD=dev-ui-password

# --- Rate limiting (in-memory, per client IP) ---
# Enabled by default; disabled automatically when NODE_ENV=test.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300
# RATE_LIMIT_LOGIN_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10

# --- Email notifications (opt-in) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=erp@example.com
# SMTP_FROM_NAME=Mermelada ERP
# SMTP_BCC=auditoria@example.com
# SMTP_TO=admin@example.com
# SMTP_RETRY_DELAY_MS=1000

# --- Cloudflare Tunnel (PM2; opt-in) ---
# TUNNEL_ENABLED=false
# TUNNEL_MODE=quick
# TUNNEL_TOKEN=
# TUNNEL_PUBLIC_URL=
# TUNNEL_INTERNAL_TOKEN=
# TUNNEL_HEALTHCHECK_INTERVAL_MS=60000
# TUNNEL_CLOUDFLARED=/usr/local/bin/cloudflared

# --- Backups ---
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14

# --- Copia externa opcional (elige una alternativa) ---
# BACKUP_REMOTE=none            # none | s3 | gdrive
# BACKUP_REMOTE_RETENTION_DAYS=15
#
# S3 o compatible (AWS S3, MinIO, Cloudflare R2, Backblaze B2):
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_PREFIX=mermelada/backups
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_SESSION_TOKEN=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_FORCE_PATH_STYLE=false
#
# Google Drive (carpeta compartida con el service account):
# BACKUP_GDRIVE_FOLDER_ID=
# BACKUP_GDRIVE_SERVICE_ACCOUNT_FILE=./secrets/gdrive-service-account.json
# BACKUP_GDRIVE_CLIENT_EMAIL=
# BACKUP_GDRIVE_PRIVATE_KEY=

# Production deployment uses .env.production; copy .env.production.example
# and read DEPLOYMENT.md before starting the service.
