# Production environment template. Copy to .env.production (never commit it).
# The file is loaded by Docker Compose, systemd EnvironmentFile or PM2 (see
# DEPLOYMENT.md).

# --- Runtime ---
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
APP_VERSION=1.0.0
APP_URL=https://erp.example.com
# Comma-separated hosts allowed by Angular SSR (domain, proxy host, loopback).
# Defaults to the APP_URL hostname when omitted.
NG_ALLOWED_HOSTS=erp.example.com,localhost,127.0.0.1
TZ=America/Bogota

# --- Docker Compose ---
# Host loopback port exposed to the reverse proxy.
APP_PORT=4000
# Full image reference (CI publishes to GHCR). Leave unset to build locally.
# IMAGE_NAME=ghcr.io/tu-usuario/mermelada-mrp-app:latest

# --- Database ---
# Docker: /app/data/mermelada.db. Bare metal: ./data/mermelada.db or an
# absolute path owned by the service user.
DB_PATH=/app/data/mermelada.db

# --- Authentication (recommended in production) ---
AUTH_ENABLED=true
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret
# Change the seeded demo password before the first production start.
AUTH_SEED_PASSWORD=replace-with-a-strong-password
AUTH_TOKEN_TTL_SECONDS=28800

# --- External services ---
# Optional. Leave empty to disable Gemini-backed features.
GEMINI_API_KEY=

# SMTP (reserved for future email notifications; no mailer is implemented yet).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=erp@example.com

# Tunnel / remote access (issue #3). The app reads no tunnel variables yet;
# keep them here so the tunnel watchdog can use the same env file.
# TUNNEL_ENABLED=false
# TUNNEL_HOSTNAME=erp.example.com
# TUNNEL_TOKEN=

# --- Backups ---
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
