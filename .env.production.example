# Production environment template. Copy to .env.production (never commit it).
# The file is loaded by Docker Compose, systemd EnvironmentFile or PM2 (see
# DEPLOYMENT.md).

# --- Runtime ---
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
APP_VERSION=1.0.0
APP_URL=https://erp.example.com
# Comma-separated hosts allowed by Angular SSR (domain, proxy host, loopback).
# Defaults to the APP_URL hostname when omitted.
NG_ALLOWED_HOSTS=erp.example.com,localhost,127.0.0.1
TZ=America/Bogota

# --- Docker Compose ---
# Host loopback port exposed to the reverse proxy.
APP_PORT=4000
# Full image reference (CI publishes to GHCR). Leave unset to build locally.
# IMAGE_NAME=ghcr.io/tu-usuario/mermelada-mrp-app:latest

# --- Database ---
# Docker: /app/data/mermelada.db. Bare metal: ./data/mermelada.db or an
# absolute path owned by the service user.
DB_PATH=/app/data/mermelada.db

# --- Authentication (recommended in production) ---
AUTH_ENABLED=true
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-secret
# Change the seeded demo password before the first production start.
AUTH_SEED_PASSWORD=replace-with-a-strong-password
AUTH_TOKEN_TTL_SECONDS=28800

# --- UI protection (HTTP Basic Auth in front of Angular) ---
# The API keeps bearer tokens + RBAC. This gate protects the SSR shell and
# static assets, including when the app is exposed through Cloudflare.
UI_AUTH_ENABLED=true
UI_AUTH_USER=erp-ui
# Generate with: openssl rand -base64 24
UI_AUTH_PASSWORD=replace-with-a-long-ui-password

# --- External services ---
# Optional. Leave empty to disable Gemini-backed features.
GEMINI_API_KEY=

# --- Email notifications (tunnel URL email) ---
# Recipients are stored in the notification_recipients table and managed at
# runtime. SMTP_TO is only used to seed that table on the very first start.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=erp@example.com
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_FROM=erp@example.com
SMTP_FROM_NAME=Mermelada ERP
# Hidden copy added to every notification. Leave empty to disable the BCC.
SMTP_BCC=auditoria@example.com
SMTP_TO=admin@example.com,operaciones@example.com
SMTP_RETRY_DELAY_MS=1000

# --- Cloudflare Tunnel (PM2) ---
# TUNNEL_ENABLED=true adds the mermelada-tunnel app to PM2. cloudflared must be
# installed and reachable (or set TUNNEL_CLOUDFLARED to its absolute path).
TUNNEL_ENABLED=false
# quick: free *.trycloudflare.com URL that changes on every restart.
# token: named tunnel with a stable hostname (requires TUNNEL_TOKEN).
TUNNEL_MODE=quick
# TUNNEL_TOKEN=replace-with-the-cloudflare-tunnel-token
# TUNNEL_PUBLIC_URL=https://erp.example.com
# Shared secret for the loopback callback. Defaults to AUTH_SECRET when empty.
TUNNEL_INTERNAL_TOKEN=
TUNNEL_HEALTHCHECK_INTERVAL_MS=60000
TUNNEL_HEALTHCHECK_FAILURES=3
# TUNNEL_CLOUDFLARED=/usr/local/bin/cloudflared

# --- Backups ---
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=14
